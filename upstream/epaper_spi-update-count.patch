+void EPaperUltraChip::on_safe_shutdown() {
+  // A battery display runs this hook before every ESP32 deep-sleep cycle, so
+  // an unconditional panel deep sleep here wiped the previous-image RAM that
+  // the next partial refresh compares against; standby keeps it, like
+  // deep_sleep() below. The 6-hourly plain full still sleeps the panel via
+  // the state machine (full_update_every == 1), and the wake after it is
+  // forced back to a full refresh by the seeding in setup().
+  if (!this->is_using_partial_update_())
+    this->send_deep_sleep_();
+}
 
